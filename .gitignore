# Deployment secrets — never commit
.deployment_secrets.txt

# Local project instructions — may contain credentials, kept off git
CLAUDE.md

# Data — large uploads and runtime files excluded
/data
# ...except curated eval assets which must be versioned
!/data/curated/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/

# Streamlit / app folders
/eda/__pycache__

# Environment variables
.env
.env.*
!/.env.example
/app/backend/.env
/app/backend/.env.*

# Local document upload storage
/storage/
/app/backend/storage/

# macOS
.DS_Store

# Node (if ever used)
node_modules/
dist/
build/
*.tsbuildinfo
app/frontend/tsconfig.tsbuildinfo

# Runtime logs / pids
logs/
logs_backup/
*.log
*.pid
*.jsonl

# Training outputs (large checkpoints, logs)
/outputs/

# IDE
.idea/

# Claude Code session data
.claude/

# Session working notes — may contain keys/credentials
SESSION_NOTES.md
